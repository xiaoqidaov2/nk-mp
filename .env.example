# Generate with: python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
NIKE_MP_CREDENTIAL_KEY=

# Optional overrides
NIKE_MP_DATABASE_URL=postgresql+psycopg://nike_mp:nike_mp@db:5432/nike_mp
NIKE_MP_SESSION_TTL_HOURS=12
NIKE_MP_COOKIE_SECURE=false
NIKE_MP_DEFAULT_CADENCE_SECONDS=1800
NIKE_MP_DAILY_REVIEW_BUDGET=60000

# 频率、冷却与失败门店补跑（详见 docs/cadence-throttle.md）
# NIKE_MP_JOB_MAX_ATTEMPTS=3                # 失败门店自动补跑轮数上限（原作业算第 0 轮）
# NIKE_MP_JOB_RETRY_DELAY_SECONDS=60        # 补跑前的最小等待秒数（与冷却窗口取较晚者）
# NIKE_MP_THROTTLE_BACKOFF_SECONDS=300,900,1800,3600   # 被上游风控命中后的冷却阶梯
# NIKE_MP_THROTTLE_NOTICE_INTERVAL_SECONDS=28800       # 降速通知最小间隔（8 小时 => 24 小时最多 3 条）
# NIKE_MP_DISPATCH_JITTER_SECONDS=10                   # 派发抖动上限（实际 ≤ 间隔的 10%）：多任务错峰，峰值不齐发
# NIKE_MP_OBSERVATION_HISTORY_LIMIT=30                 # 每个(门店,货号,尺码)保留的历史观测条数；约 30 次足够回溯

# 多 scheduler / 多 worker 与调度监控（详见 docs/architecture.md）
# NIKE_MP_SCHEDULER_INTERVAL_SECONDS=10     # 派发粒度（秒）
# NIKE_MP_DISPATCH_LOCK_KEY=86085326602241  # 派发互斥的 advisory lock key（多 scheduler 抢锁，抢不到即主备待命）
# NIKE_MP_MONITOR_INTERVAL_SECONDS=60       # 监控服务轮询间隔（秒）
# NIKE_MP_MONITOR_STALE_SECONDS=60          # 心跳超过这么久未更新视为掉线
# NIKE_MP_MONITOR_OVERDUE_GRACE_SECONDS=300 # 超过 next_run_at 这么久且无作业才算"迟到"

# 单轮耗时（详见 docs/cadence-throttle.md「一轮耗时」）
# NIKE_MP_REVIEW_POLL_FIRST_SECONDS=0.5     # 首次轮询等待；结果通常已就绪
# NIKE_MP_REVIEW_POLL_INTERVAL_SECONDS=2.5  # 后续轮询间隔上限（从 first 起翻倍封顶）
# NIKE_MP_REQUEST_RETRY_BASE_SECONDS=1.5    # 上游重试退避基数（405 挑战/5xx/403/429）
# NIKE_MP_REQUEST_RETRY_MAX_SECONDS=8.0     # 上游重试退避上限
# NIKE_MP_STORE_CONCURRENCY=1               # 单作业内的门店并发数（实测到 16 并发时 405 拦截率仍稳定在 ~57–63%，可放心上调；上限 32）
# NIKE_MP_WAF_RETRY_LIMIT=12                # 405 挑战的独立重试预算（不影响 403/5xx 的 request_retry_limit）

# 万级吞吐闸门（详见 docs/cadence-throttle.md「容量」一节）
#   小时闸按「到达业务层的应答」计次（405 挑战与传输失败不记账，见「额度算术」）；
#   以实测 ~50% 挑战率计，同样的闸值买到约 2 倍事务量。
# NIKE_MP_QUOTA_HOURLY_CAP=30000            # 平台小时上限（默认 900，按应答计次）
# NIKE_MP_QUOTA_HOURLY_SLOW_LINE=24000      # 仅告警不拦截（默认 600）
# NIKE_MP_DAILY_REVIEW_BUDGET=1000000       # 平台日上限（默认 60000，按应答计次）

# Self-service Nike phone binding (disabled by default). When enabled, the
# contract version must equal SUPPORTED_CONTRACT_VERSION in
# apps/api/app/nike/phone_auth.py.
NIKE_MP_NIKE_PHONE_AUTH_ENABLED=false
NIKE_MP_NIKE_PHONE_AUTH_CONTRACT_VERSION=
# Only set this when the API sits behind a reverse proxy you control:
# NIKE_MP_NIKE_SMS_TRUSTED_PROXY_CIDRS=["10.0.0.0/8"]

# Platform DingTalk bot (enterprise robot). Users link a group or single chat
# by sending a one-time code, then use keyword commands and receive reminders
# there. Disabled by default; secrets stay in the deployment environment.
NIKE_MP_DINGTALK_BOT_ENABLED=false
NIKE_MP_DINGTALK_BOT_CLIENT_ID=
NIKE_MP_DINGTALK_BOT_CLIENT_SECRET=
NIKE_MP_DINGTALK_LINK_CODE_TTL_SECONDS=900

# 出口池（详见 docs/cadence-throttle.md「出口池与指纹轮换」）
#   轮转（默认）：一请求一出口，多出口分散并发；住宅池不要用轮换。
#   粘性：钉住同一条出口（稳定住宅/移动 IP、一账号一 IP），拿到大陆出口做 A/B 时用它。
# NIKE_MP_PROXY_URLS=["http://user:pass@host:8080"]
# NIKE_MP_PROXY_URLS_FILE=/data/proxies.txt
# NIKE_MP_PROXY_STICKY=true
# NIKE_MP_PROXY_COOLDOWN_SECONDS=120
# NIKE_MP_FINGERPRINT_ROTATION=true
